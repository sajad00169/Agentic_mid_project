# LLM Provider Configuration (Optional - Out-of-the-box deterministic fallback works without keys)
# Provide GOOGLE_API_KEY or GEMINI_API_KEY to activate live Gemini models
GOOGLE_API_KEY=
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Optional OpenAI configuration
OPENAI_API_KEY=

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=student-fee-management-agent

# System Parameters
REFERENCE_DATE=2024-11-01
CURRENCY_SYMBOL=PKR
